generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(schema: "public")]
}

model User {
  id                                 String                  @id @unique
  username                           String                  @unique
  email                              String                  @unique
  passwordHash                       String
  mediaUrls                          String[]
  accountStatus                      String                  @default("active")
  createdAt                          DateTime                @default(now())
  updatedAt                          DateTime                @updatedAt
  fcmTokens                          String[]                @default([])
  phoneNumber                        String?                 @db.VarChar(50)
  accommodationBookings              AccommodationBooking[]
  accommodationProvider              AccommodationProvider?
  admin                              Admin?
  comments                           Comment[]
  receivedMessages                   Message[]               @relation("ReceiverMessages")
  sentMessages                       Message[]               @relation("SenderMessages")
  notifications                      Notification[]
  receivedOffers                     Offer[]                 @relation("ReceivedOffers")
  sentOffers                         Offer[]                 @relation("SentOffers")
  questions                          Question[]
  Report_Report_reportedUserIdToUser Report[]                @relation("Report_reportedUserIdToUser")
  Report_Report_reporterIdToUser     Report[]                @relation("Report_reporterIdToUser")
  reviews                            Review[]                @relation("ReviewerRelation")
  SavedTripPlan                      SavedTripPlan[]
  transportationBookings             TransportationBooking[]
  transportationProvider             TransportationProvider?
  TransportationRequest              TransportationRequest[]
  traveler                           Traveler?
  trips                              Trip[]
  roles                              UserRole[]
  Vote                               Vote[]

  @@index([email])
  @@index([accountStatus])
}

model Role {
  id       Int        @id @default(autoincrement())
  roleName String     @unique
  users    UserRole[]
}

model UserRole {
  userId String
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model TransportationProvider {
  providerId        String                  @id
  licenseMmediaUrls String[]
  vehicleMediaUrls  String[]
  vehicleType       String
  seatsAvailable    Int
  createdAt         DateTime                @default(now())
  accountStatus     String                  @default("pending")
  listings          TransportationListing[]
  user              User                    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([vehicleType])
}

model AccommodationProvider {
  providerId        String          @id
  accommodationName String
  address           String
  contactNumber     String
  mediaUrls         String[]
  createdAt         DateTime        @default(now())
  accommodations    Accommodation[]
  user              User            @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([accommodationName])
}

model TransportationRequest {
  id                Int                     @id @default(autoincrement())
  travelerId        String
  departureTime     DateTime
  seatsNeeded       Int
  budget            Decimal                 @db.Decimal(10, 2)
  createdAt         DateTime                @default(now())
  endLocationLat    Float?
  endLocationLng    Float?
  endLocationText   String
  startLocationLat  Float?
  startLocationLng  Float?
  startLocationText String
  luggage           Int                     @default(0)
  offers            Offer[]
  bookings          TransportationBooking[]
  traveler          User                    @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  @@index([travelerId])
  @@index([startLocationText, endLocationText])
  @@index([departureTime])
}

model TransportationListing {
  id                                                                             Int                     @id @default(autoincrement())
  providerId                                                                     String
  departureTime                                                                  DateTime
  pricePerSeat                                                                   Decimal                 @db.Decimal(10, 2)
  seatsAvailable                                                                 Int
  status                                                                         String                  @default("active")
  mediaUrls                                                                      String[]
  createdAt                                                                      DateTime                @default(now())
  endLocationLat                                                                 Float?
  endLocationLng                                                                 Float?
  endLocationText                                                                String
  startLocationLat                                                               Float?
  startLocationLng                                                               Float?
  startLocationText                                                              String
  luggage                                                                        Int                     @default(0)
  offers                                                                         Offer[]
  Report                                                                         Report[]
  reviews                                                                        Review[]                @relation("TransportationListingReviews")
  SavedTripPlan_SavedTripPlan_selectedOutboundTransportIdToTransportationListing SavedTripPlan[]         @relation("SavedTripPlan_selectedOutboundTransportIdToTransportationListing")
  SavedTripPlan_SavedTripPlan_selectedReturnTransportIdToTransportationListing   SavedTripPlan[]         @relation("SavedTripPlan_selectedReturnTransportIdToTransportationListing")
  bookings                                                                       TransportationBooking[]
  provider                                                                       TransportationProvider  @relation(fields: [providerId], references: [providerId], onDelete: Cascade)

  @@index([providerId])
  @@index([startLocationText, endLocationText])
  @@index([departureTime])
  @@index([status])
}

model TransportationBooking {
  id                      Int                    @id @default(autoincrement())
  travelerId              String
  seatsBooked             Int
  luggage                 String?
  status                  String                 @default("pending")
  totalPrice              Decimal                @db.Decimal(10, 2)
  createdAt               DateTime               @default(now())
  bookingSource           String                 @default("listing")
  transportationListingId Int?
  transportationRequestId Int?
  offerId                 Int?
  Report                  Report[]
  reviews                 Review[]               @relation("TransportationBookingReviews")
  offer                   Offer?                 @relation(fields: [offerId], references: [id])
  listing                 TransportationListing? @relation(fields: [transportationListingId], references: [id], onDelete: Cascade)
  request                 TransportationRequest? @relation(fields: [transportationRequestId], references: [id], onDelete: Cascade)
  traveler                User                   @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  @@index([travelerId])
  @@index([status])
  @@index([createdAt])
  @@index([transportationListingId])
  @@index([transportationRequestId])
  @@index([offerId])
}

model Offer {
  id                      Int                     @id @default(autoincrement())
  senderId                String
  recipientId             String
  pricePerSeat            Decimal                 @db.Decimal(10, 2)
  seatsRequested          Int
  message                 String?
  status                  String                  @default("pending")
  createdAt               DateTime                @default(now())
  transportationListingId Int?
  transportationRequestId Int?
  recipient               User                    @relation("ReceivedOffers", fields: [recipientId], references: [id], onDelete: Cascade)
  sender                  User                    @relation("SentOffers", fields: [senderId], references: [id], onDelete: Cascade)
  listing                 TransportationListing?  @relation(fields: [transportationListingId], references: [id], onDelete: Cascade)
  request                 TransportationRequest?  @relation(fields: [transportationRequestId], references: [id], onDelete: Cascade)
  Report                  Report[]
  bookings                TransportationBooking[]

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([transportationListingId])
  @@index([transportationRequestId])
}

model Accommodation {
  id            Int                   @id @default(autoincrement())
  providerId    String
  name          String
  location      String
  description   String
  mediaUrls     String[]
  createdAt     DateTime              @default(now())
  provider      AccommodationProvider @relation(fields: [providerId], references: [providerId], onDelete: Cascade)
  Report        Report[]
  reviews       Review[]              @relation("AccommodationReviews")
  rooms         Room[]
  SavedTripPlan SavedTripPlan[]

  @@index([providerId])
  @@index([location])
  @@index([name])
}

model Room {
  id                      Int                       @id @default(autoincrement())
  accommodationId         Int
  roomType                String
  pricePerNight           Decimal                   @db.Decimal(10, 2)
  capacity                Int
  mediaUrls               String[]
  createdAt               DateTime                  @default(now())
  bookings                AccommodationBooking[]
  Report                  Report[]
  reviews                 Review[]                  @relation("RoomReviews")
  accommodation           Accommodation             @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  SavedPlanRoomAllocation SavedPlanRoomAllocation[]

  @@index([accommodationId])
  @@index([roomType])
  @@index([pricePerNight])
  @@index([capacity])
}

model AccommodationBooking {
  id           Int      @id @default(autoincrement())
  travelerId   String
  roomId       Int
  checkInDate  DateTime
  checkOutDate DateTime
  status       String   @default("pending")
  totalPrice   Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  traveler     User     @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  payment      Payment? @relation("AccommodationPayment")
  Report       Report[]
  reviews      Review[] @relation("AccommodationBookingReviews")

  @@index([travelerId])
  @@index([roomId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
}

model Payment {
  id                     Int                   @id @default(autoincrement())
  amount                 Decimal               @db.Decimal(10, 2)
  paymentMethod          String
  status                 String                @default("pending")
  transactionId          String                @unique
  createdAt              DateTime              @default(now())
  accommodationBookingId Int?                  @unique
  accommodationBooking   AccommodationBooking? @relation("AccommodationPayment", fields: [accommodationBookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   String
  receiverId String
  content    String
  sentAt     DateTime @default(now())
  receiver   User     @relation("ReceiverMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  Report     Report[]

  @@index([senderId])
  @@index([receiverId])
  @@index([sentAt])
}

model Review {
  id                      Int                    @id @default(autoincrement())
  reviewerId              String
  reviewableType          String
  rating                  Int
  comment                 String
  createdAt               DateTime               @default(now())
  transportationListingId Int?
  accommodationId         Int?
  roomId                  Int?
  transportationBookingId Int?
  accommodationBookingId  Int?
  accommodationBooking    AccommodationBooking?  @relation("AccommodationBookingReviews", fields: [accommodationBookingId], references: [id], onDelete: Cascade)
  accommodation           Accommodation?         @relation("AccommodationReviews", fields: [accommodationId], references: [id], onDelete: Cascade)
  reviewer                User                   @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)
  room                    Room?                  @relation("RoomReviews", fields: [roomId], references: [id], onDelete: Cascade)
  transportationBooking   TransportationBooking? @relation("TransportationBookingReviews", fields: [transportationBookingId], references: [id], onDelete: Cascade)
  transportationListing   TransportationListing? @relation("TransportationListingReviews", fields: [transportationListingId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@index([reviewableType])
  @@index([rating])
}

model Trip {
  id          Int            @id @default(autoincrement())
  travelerId  String
  destination String
  startDate   DateTime
  endDate     DateTime
  budget      Decimal        @db.Decimal(10, 2)
  createdAt   DateTime       @default(now())
  traveler    User           @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  activities  TripActivity[]

  @@index([travelerId])
  @@index([destination])
  @@index([startDate, endDate])
}

model TripActivity {
  id           Int      @id @default(autoincrement())
  tripId       Int
  activityName String
  date         DateTime
  time         DateTime
  description  String
  createdAt    DateTime @default(now())
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([date])
}

model Traveler {
  travelerId  String   @id
  preferences String[]
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [travelerId], references: [id], onDelete: Cascade)
}

model Admin {
  adminId     String   @id
  permissions String[]
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  Report      Report[]
}

model Question {
  id          Int       @id @default(autoincrement())
  userId      String
  title       String
  description String
  upvotes     Int       @default(0)
  downvotes   Int       @default(0)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  tags        String[]
  comments    Comment[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Report      Report[]
  vote        Vote[]

  @@index([userId])
  @@index([title])
  @@index([tags])
  @@index([createdAt])
  @@index([upvotes, downvotes])
}

model Comment {
  id         Int      @id @default(autoincrement())
  userId     String
  questionId Int
  content    String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Report     Report[]

  @@index([userId])
  @@index([questionId])
  @@index([createdAt])
}

model Vote {
  id         Int      @id @default(autoincrement())
  userId     String
  questionId Int
  type       VoteType
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model Report {
  id                               Int                    @id @default(autoincrement())
  reporterId                       String
  reportableType                   String
  reportReason                     String
  description                      String
  status                           String                 @default("pending")
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime
  resolvedAt                       DateTime?
  resolvedBy                       String?
  resolutionNotes                  String?
  reportedUserId                   String?
  transportationListingId          Int?
  accommodationId                  Int?
  roomId                           Int?
  questionId                       Int?
  commentId                        Int?
  messageId                        Int?
  offerId                          Int?
  transportationBookingId          Int?
  accommodationBookingId           Int?
  AccommodationBooking             AccommodationBooking?  @relation(fields: [accommodationBookingId], references: [id], onDelete: Cascade)
  Accommodation                    Accommodation?         @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  Comment                          Comment?               @relation(fields: [commentId], references: [id], onDelete: Cascade)
  Message                          Message?               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  Offer                            Offer?                 @relation(fields: [offerId], references: [id], onDelete: Cascade)
  Question                         Question?              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  User_Report_reportedUserIdToUser User?                  @relation("Report_reportedUserIdToUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  User_Report_reporterIdToUser     User                   @relation("Report_reporterIdToUser", fields: [reporterId], references: [id], onDelete: Cascade)
  Admin                            Admin?                 @relation(fields: [resolvedBy], references: [adminId])
  Room                             Room?                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  TransportationBooking            TransportationBooking? @relation(fields: [transportationBookingId], references: [id], onDelete: Cascade)
  TransportationListing            TransportationListing? @relation(fields: [transportationListingId], references: [id], onDelete: Cascade)

  @@index([accommodationBookingId])
  @@index([accommodationId])
  @@index([commentId])
  @@index([createdAt])
  @@index([messageId])
  @@index([offerId])
  @@index([questionId])
  @@index([reportableType])
  @@index([reportedUserId])
  @@index([reporterId])
  @@index([roomId])
  @@index([status])
  @@index([transportationBookingId])
  @@index([transportationListingId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model SavedPlanRoomAllocation {
  id            Int           @id @default(autoincrement())
  savedPlanId   Int
  roomId        Int
  numberOfRooms Int           @default(1)
  checkInDate   DateTime
  checkOutDate  DateTime
  Room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  SavedTripPlan SavedTripPlan @relation(fields: [savedPlanId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([savedPlanId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model SavedTripPlan {
  id                                                                                     Int                       @id @default(autoincrement())
  userId                                                                                 String
  planName                                                                               String
  status                                                                                 String                    @default("draft")
  startLocation                                                                          String
  endLocation                                                                            String
  startTime                                                                              DateTime
  endTime                                                                                DateTime
  numberOfTravelers                                                                      Int
  budget                                                                                 Decimal                   @db.Decimal(10, 2)
  interests                                                                              String[]
  needsReturnTransport                                                                   Boolean                   @default(true)
  selectedOutboundTransportId                                                            Int?
  selectedReturnTransportId                                                              Int?
  selectedAccommodationId                                                                Int?
  seatsNeeded                                                                            Int?
  planData                                                                               Json?
  notes                                                                                  String?
  tags                                                                                   String[]
  createdAt                                                                              DateTime                  @default(now())
  updatedAt                                                                              DateTime                  @default(now())
  lastViewedAt                                                                           DateTime?
  SavedPlanRoomAllocation                                                                SavedPlanRoomAllocation[]
  Accommodation                                                                          Accommodation?            @relation(fields: [selectedAccommodationId], references: [id], onUpdate: NoAction)
  TransportationListing_SavedTripPlan_selectedOutboundTransportIdToTransportationListing TransportationListing?    @relation("SavedTripPlan_selectedOutboundTransportIdToTransportationListing", fields: [selectedOutboundTransportId], references: [id], onUpdate: NoAction)
  TransportationListing_SavedTripPlan_selectedReturnTransportIdToTransportationListing   TransportationListing?    @relation("SavedTripPlan_selectedReturnTransportIdToTransportationListing", fields: [selectedReturnTransportId], references: [id], onUpdate: NoAction)
  User                                                                                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt])
  @@index([startTime])
  @@index([status])
  @@index([tags], type: Gin)
  @@index([userId])
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ReportableType {
  USER
  TRANSPORTATION_LISTING
  ACCOMMODATION
  ROOM
  REVIEW
  QUESTION
  COMMENT
  MESSAGE
}
