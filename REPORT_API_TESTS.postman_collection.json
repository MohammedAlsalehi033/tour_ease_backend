    {
      "name": "User Endpoints",
      "item": [
        {
          "name": "Create Report - User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportableType\": \"USER\",\n  \"reportReason\": \"Inappropriate behavior\",\n  \"description\": \"This user sent me inappropriate messages and made me feel uncomfortable.\",\n  \"reportedUserId\": \"test-user-2\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/reports",
              "host": ["{{base_url}}"],
              "path": ["reports"]
            }
          }
        },
        {
          "name": "Create Report - Transportation Listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportableType\": \"TRANSPORTATION_LISTING\",\n  \"reportReason\": \"Fake listing\",\n  \"description\": \"This transportation listing appears to be fake. The provider is not responding to messages.\",\n  \"transportationListingId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/reports",
              "host": ["{{base_url}}"],
              "path": ["reports"]
            }
          }
        },
        {
          "name": "Create Report - Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportableType\": \"QUESTION\",\n  \"reportReason\": \"Spam\",\n  \"description\": \"This question is spam and not related to travel.\",\n  \"questionId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/reports",
              "host": ["{{base_url}}"],
              "path": ["reports"]
            }
          }
        },
        {
          "name": "Create Report - Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportableType\": \"COMMENT\",\n  \"reportReason\": \"Inappropriate content\",\n  \"description\": \"This comment contains inappropriate language and should be removed.\",\n  \"commentId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/reports",
              "host": ["{{base_url}}"],
              "path": ["reports"]
            }
          }
        },
        {
          "name": "Get My Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/reports/my-reports?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["reports", "my-reports"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
