{
  "info": {
    "name": "TourEase Report API Tests",
    "description": "Complete API test collection for the report functionality",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your-jwt-token-here",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "your-admin-jwt-token-here",
      "type": "string"
    },
    {
      "key": "report_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Setup - Create Sample Data",
      "item": [
        {
          "name": "Create Sample Data",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/test/reports/create-sample-data",
              "host": ["{{base_url}}"],
              "path": ["test", "reports", "create-sample-data"]
            }
          }
        },
        {
          "name": "Create Sample Reports",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/test/reports/create-sample-reports",
              "host": ["{{base_url}}"],
              "path": ["test", "reports", "create-sample-reports"]
            }
          }
        }
      ]
