# AI Cost Optimization Settings
# Set these to control AI feature usage and minimize costs

# Core AI features (enabled by default but can be disabled)
USE_AI_ANALYSIS=true          # AI analysis for trip planning iterations (recommended: true)
USE_AI_FEEDBACK=true          # AI interpretation of user feedback (recommended: true)

# Optional AI features (disabled by default to save costs)
USE_AI_ENHANCEMENT=false      # AI enhancement of plan descriptions (expensive, set to true only if needed)
USE_AI_ACTIVITIES=false       # AI-generated activity suggestions (expensive, set to true only if needed)

# Your existing environment variables
GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=your_database_url_here
PORT=3000

# Firebase Admin service account JSON (keep outside git)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
